# Copy this file to .env.production on the server. Do not upload local .env.
#
# Disk layout (same machine, Convert only frontend + backend in IIS):
#   lfb_cms/frontend  <- cms-frontend/dist
#   lfb_cms/backend   <- cms-backend

NODE_ENV=production
# PM2 port — must match web.config proxy (IPMS uses 4000)
PORT=4001
FRONTEND_URL=http://YOUR_SERVER:90/lfb_cms/frontend
# Extra browser origins if people open the site by IP as well as hostname:
# CORS_ORIGINS=http://10.0.0.10
JWT_SECRET=change-this-to-at-least-32-characters
AUTH_TOKEN_TTL=8h
COOKIE_SAME_SITE=lax
COOKIE_SECURE=0
COOKIE_DOMAIN=
TRUST_PROXY=1
BASE_PATH=/lfb_cms/backend
SEED_DEMO_DATA=0
ALLOW_MISSING_SMTP=1

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=lfb_cms
DB_POOL_LIMIT=40
DB_POOL_QUEUE_LIMIT=200

SHARED_DB_NAME=shared_auth
CENTER_USER_TABLE=Center_user_lfb

# ERP API on the same server. CMS talks to itself, not the browser.
ERP_API_ENABLED=1
ERP_API_URL=http://127.0.0.1:3100
ERP_API_TIMEOUT_MS=5000
