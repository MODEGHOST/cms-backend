# Local development only. Copy to .env on your machine.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5174
# Must match LFB Center Portal (lfb-backend) so cookie lfb_token is accepted.
JWT_SECRET=lfb-center-change-this-in-production
AUTH_TOKEN_TTL=8h
COOKIE_SAME_SITE=lax
COOKIE_SECURE=0
COOKIE_DOMAIN=
TRUST_PROXY=0
SEED_DEMO_DATA=1
# IIS virtual path when the reverse proxy does not strip it. Leave empty for local Vite proxy.
# Production example: /lfb_cms/backend
BASE_PATH=

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cms
DB_POOL_LIMIT=40
# Max waiting queries when all pool connections are busy (0 = unlimited; avoid in prod)
DB_POOL_QUEUE_LIMIT=200
# Reuse hydrated user+RBAC briefly (seconds). 0 disables. Role changes apply within this window.
AUTH_USER_CACHE_TTL_SEC=20
# Max parallel SQL per dashboard summary wave (keeps pool free for other users)
DASHBOARD_SQL_BATCH_SIZE=4
# Cap reject day-detail row list (KPI/counts still full)
DASHBOARD_DAY_DETAIL_LIMIT=500
# Central SSO identity
SHARED_DB_NAME=shared_auth
CENTER_USER_TABLE=Center_user_lfb

# Email (forgot/reset password). Empty SMTP logs the reset link in development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Production without SMTP: set ALLOW_MISSING_SMTP=1
ALLOW_MISSING_SMTP=1

# Telegram Bot Notifications (Complaint / Reject)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=0
# Dev/solo: send every status update to one group (numeric chat id, e.g. -100123...)
TELEGRAM_GROUP_CHAT_ID=
# Optional static invite. ถ้าเว้นว่าง ระบบจะขอลิงก์จากบอทตอนกดปุ่มเข้ากลุ่ม
TELEGRAM_GROUP_INVITE_LINK=

# Telegram Auth Bot (account link / forgot password) — private chat only
TELEGRAM_AUTH_BOT_TOKEN=
TELEGRAM_AUTH_BOT_USERNAME=
TELEGRAM_AUTH_BOT_ENABLED=0

# ERP PDR API (Beta_api_erp) — ปิดไว้ก่อน; เปิดเมื่อพร้อมเท่านั้น
# เรียกแค่ /api/pdr?pdr_no=... (ไม่ดึงทั้งตาราง)
ERP_API_ENABLED=0
ERP_API_URL=http://127.0.0.1:3100
ERP_API_TIMEOUT_MS=5000
