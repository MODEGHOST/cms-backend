# Local development only. Copy to .env on your machine.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-this-in-production
AUTH_TOKEN_TTL=8h
COOKIE_SAME_SITE=lax
COOKIE_SECURE=0
