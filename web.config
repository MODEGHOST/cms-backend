<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy to PM2 (same pattern as lfb_ipms/backend).
  PM2 PORT from .env.production (4001; IPMS uses 4000).
  Requires URL Rewrite and ARR proxy (already on server for IPMS).

  On server: cd lfb_cms\backend
  pm2 start ecosystem.config.cjs
  pm2 save
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="CMS API PM2 proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:4001/lfb_cms/backend/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
