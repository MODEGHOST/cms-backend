<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS + HttpPlatformHandler: run Node backend under /lfb_cms/backend
  Same pattern as prdproject /lfb_ipms/backend.
  Requires HttpPlatformHandler. Adjust processPath if Node is installed elsewhere.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>
    <httpPlatform processPath="%ProgramFiles%\nodejs\node.exe"
                  arguments="src\server.js"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node"
                  startupTimeLimit="60"
                  processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
