<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy → PM2 Node process (same pattern as lfb_ipms/backend).
  PM2 listens on PORT from .env.production (default 4001 — IPMS uses 4000).
  Requires URL Rewrite + ARR proxy enabled on the server (already used by IPMS).

  Start on server:
    cd lfb_cms\backend
    pm2 start ecosystem.config.cjs --env production
    pm2 save
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="CMS API PM2 proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:4001/lfb_cms/backend/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
